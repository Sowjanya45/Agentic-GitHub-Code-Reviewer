# Copy to .env and fill in. Never commit .env.

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
SESSION_SECRET=change-me
FRONTEND_URL=http://localhost:5173

# --- Database (docker compose overrides host with "postgres") ---
POSTGRES_USER=codelens
POSTGRES_PASSWORD=codelens
POSTGRES_DB=codelens
DATABASE_URL=postgresql+psycopg://codelens:codelens@localhost:5432/codelens

# --- Redis (used from Phase 10) ---
REDIS_URL=redis://localhost:6379/0

# --- GitHub OAuth (used from Phase 2) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/github/callback

# --- LLM (used from Phase 4) ---
LLM_PROVIDER=groq
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
